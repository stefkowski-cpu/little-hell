{
  "rules": {
    "rooms": {
      "$roomCode": {
        // Room-level: only authenticated users
        ".read": "auth !== null",

        "host": {
          ".write": "auth !== null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },

        "createdAt": {
          ".write": "auth !== null && !data.exists()",
          ".validate": "newData.val() === now"
        },

        "status": {
          // Host can change status; transitions: waiting → playing → finished
          ".write": "auth !== null && (root.child('rooms/' + $roomCode + '/host').val() === auth.uid || (data.val() === 'playing' && newData.val() === 'finished'))",
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
        },

        "matchId": {
          // Only host can set matchId
          ".write": "auth !== null && root.child('rooms/' + $roomCode + '/host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },

        "players": {
          "$uid": {
            // Players can write their own node; host can delete any player
            ".write": "auth !== null && (auth.uid === $uid || root.child('rooms/' + $roomCode + '/host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'avatar', 'online'])",

            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
            },
            "avatar": {
              // Only allow whitelisted avatar paths
              ".validate": "newData.isString() && newData.val().matches(/^avatars\\/[mf][1-4]\\.webp$/)"
            },
            "rating": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "rd": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "gameState": {
          // Any authenticated room participant can write gameState
          // (both host and guest push state during gameplay)
          ".write": "auth !== null && root.child('rooms/' + $roomCode + '/players/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['matchId', 'revision', 'phase', 'round', 'target', 'turnPos', 'turnUid', 'lastAction', 'actorUid', 'timestamp'])",

          "matchId": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "revision": {
            // Monotonically increasing — new revision must be >= current
            ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || !data.child('revision').exists() || newData.val() >= data.parent().child('revision').val())"
          },
          "phase": {
            ".validate": "newData.isString() && (newData.val() === 'ready' || newData.val() === 'rolling' || newData.val() === 'choose' || newData.val() === 'roundEnd' || newData.val() === 'gameEnd')"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 16"
          },
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 18"
          },
          "turnPos": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "turnUid": {
            ".validate": "newData.isString()"
          },
          "actorUid": {
            // Must be the authenticated user writing
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "lastAction": {
            ".validate": "newData.isString() && (newData.val() === 'roll' || newData.val() === 'choose' || newData.val() === 'turnEnd' || newData.val() === 'roundEnd' || newData.val() === 'gameEnd' || newData.val() === 'init')"
          },
          "timestamp": {
            ".validate": "newData.val() === now"
          },
          "order": {
            ".validate": true
          },
          "currentIdx": {
            ".validate": "newData.isNumber()"
          },
          "playerStates": {
            "$playerUid": {
              ".validate": "root.child('rooms/' + $roomCode + '/players/' + $playerUid).exists()"
            }
          },
          "$other": {
            ".validate": true
          }
        },

        // Host can delete entire room
        ".write": "auth !== null && ((!data.exists()) || root.child('rooms/' + $roomCode + '/host').val() === auth.uid)"
      }
    },

    // User profiles — each user can only read/write their own
    "profiles": {
      "$uid": {
        ".read": "auth !== null",
        ".write": "auth !== null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",

        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^avatars\\/[mf][1-4]\\.webp$/)"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "rd": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "vol": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    // Deny all other paths
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
